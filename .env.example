# Secret used by NextAuth to sign/encrypt cookies and tokens
AUTH_SECRET=your_secret_key_at_least_32_chars_long

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/remoteaccess

# Default SSH user for remote node shutdown commands
ADMIN=admin

# Application display name in navigation
NAME=RemoteAccess

# Base URL (optional in Next.js 14 / NextAuth v5, but useful if behind reverse proxy)
NEXTAUTH_URL=http://localhost:3000
